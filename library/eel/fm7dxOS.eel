// fm7dx (6-op FM7 clone, DX7 feedback) + variable OVERSAMPLING.
// Runs the whole FM matrix at 2^_os times the sample rate, then decimates each
// operator through a 4th-order Butterworth low-pass -> much less aliasing at
// high feedback / modulation index.
//
// params: same as fm7dx (_f1.._f6, _a1.._a6, _o1.._o6, _mIJ) plus:
//   _os  oversampling index 0..4  -> ratio 1,2,4,8,16 (0 = off)
// outputs: out0..out5 = the six operator signals
//
// filter coefficients are shared by all channels and only recomputed when _os
// changes; per-channel biquad state is p*/q* (x/y histories).

@init
oslast = -1;   // force coefficient computation on the first sample

@sample
// --- (re)compute oversampling ratio + anti-alias filter when _os changes ---
_os != oslast ? (
    idx = max(0, min(4, floor(_os)));
    ratio = pow(2, idx);
    osrate = srate * ratio;
    f0 = 0.49 / ratio;                       // cutoff ~ base Nyquist, as fraction of OS rate
    w0 = 2.0*$pi*f0; cw = cos(w0); sw = sin(w0);
    nb0 = (1.0-cw)*0.5; nb1 = 1.0-cw; nb2 = (1.0-cw)*0.5;
    al = sw/(2.0*0.54119610); a0 = 1.0+al;   // Butterworth biquad A (Q=0.5412)
    b0A=nb0/a0; b1A=nb1/a0; b2A=nb2/a0; a1A=(-2.0*cw)/a0; a2A=(1.0-al)/a0;
    al = sw/(2.0*1.30656296); a0 = 1.0+al;   // Butterworth biquad B (Q=1.3066)
    b0B=nb0/a0; b1B=nb1/a0; b2B=nb2/a0; a1B=(-2.0*cw)/a0; a2B=(1.0-al)/a0;
    oslast = _os;
);

inc1=_f1/osrate; inc2=_f2/osrate; inc3=_f3/osrate;
inc4=_f4/osrate; inc5=_f5/osrate; inc6=_f6/osrate;

loop(ratio,
    // ---- one oversampled step of the FM7/DX7 matrix ----
    fb1=0.5*(m1+n1); fb2=0.5*(m2+n2); fb3=0.5*(m3+n3);
    fb4=0.5*(m4+n4); fb5=0.5*(m5+n5); fb6=0.5*(m6+n6);

    pm1=_o1 + _m11*fb1 + _m12*m2 + _m13*m3 + _m14*m4 + _m15*m5 + _m16*m6;
    pm2=_o2 + _m21*m1 + _m22*fb2 + _m23*m3 + _m24*m4 + _m25*m5 + _m26*m6;
    pm3=_o3 + _m31*m1 + _m32*m2 + _m33*fb3 + _m34*m4 + _m35*m5 + _m36*m6;
    pm4=_o4 + _m41*m1 + _m42*m2 + _m43*m3 + _m44*fb4 + _m45*m5 + _m46*m6;
    pm5=_o5 + _m51*m1 + _m52*m2 + _m53*m3 + _m54*m4 + _m55*fb5 + _m56*m6;
    pm6=_o6 + _m61*m1 + _m62*m2 + _m63*m3 + _m64*m4 + _m65*m5 + _m66*fb6;

    ph1+=inc1; ph1-=(ph1>=1.0); s1=_a1*sin(2.0*$pi*ph1+pm1);
    ph2+=inc2; ph2-=(ph2>=1.0); s2=_a2*sin(2.0*$pi*ph2+pm2);
    ph3+=inc3; ph3-=(ph3>=1.0); s3=_a3*sin(2.0*$pi*ph3+pm3);
    ph4+=inc4; ph4-=(ph4>=1.0); s4=_a4*sin(2.0*$pi*ph4+pm4);
    ph5+=inc5; ph5-=(ph5>=1.0); s5=_a5*sin(2.0*$pi*ph5+pm5);
    ph6+=inc6; ph6-=(ph6>=1.0); s6=_a6*sin(2.0*$pi*ph6+pm6);

    n1=m1; m1=s1; n2=m2; m2=s2; n3=m3; m3=s3;
    n4=m4; m4=s4; n5=m5; m5=s5; n6=m6; m6=s6;

    // ---- per-channel 4th-order Butterworth decimation filter (2 biquads) ----
    oA=b0A*s1+b1A*p1a1+b2A*p1a2-a1A*q1a1-a2A*q1a2; p1a2=p1a1;p1a1=s1;q1a2=q1a1;q1a1=oA;
    oB=b0B*oA+b1B*p1b1+b2B*p1b2-a1B*q1b1-a2B*q1b2; p1b2=p1b1;p1b1=oA;q1b2=q1b1;q1b1=oB; y1=oB;
    oA=b0A*s2+b1A*p2a1+b2A*p2a2-a1A*q2a1-a2A*q2a2; p2a2=p2a1;p2a1=s2;q2a2=q2a1;q2a1=oA;
    oB=b0B*oA+b1B*p2b1+b2B*p2b2-a1B*q2b1-a2B*q2b2; p2b2=p2b1;p2b1=oA;q2b2=q2b1;q2b1=oB; y2=oB;
    oA=b0A*s3+b1A*p3a1+b2A*p3a2-a1A*q3a1-a2A*q3a2; p3a2=p3a1;p3a1=s3;q3a2=q3a1;q3a1=oA;
    oB=b0B*oA+b1B*p3b1+b2B*p3b2-a1B*q3b1-a2B*q3b2; p3b2=p3b1;p3b1=oA;q3b2=q3b1;q3b1=oB; y3=oB;
    oA=b0A*s4+b1A*p4a1+b2A*p4a2-a1A*q4a1-a2A*q4a2; p4a2=p4a1;p4a1=s4;q4a2=q4a1;q4a1=oA;
    oB=b0B*oA+b1B*p4b1+b2B*p4b2-a1B*q4b1-a2B*q4b2; p4b2=p4b1;p4b1=oA;q4b2=q4b1;q4b1=oB; y4=oB;
    oA=b0A*s5+b1A*p5a1+b2A*p5a2-a1A*q5a1-a2A*q5a2; p5a2=p5a1;p5a1=s5;q5a2=q5a1;q5a1=oA;
    oB=b0B*oA+b1B*p5b1+b2B*p5b2-a1B*q5b1-a2B*q5b2; p5b2=p5b1;p5b1=oA;q5b2=q5b1;q5b1=oB; y5=oB;
    oA=b0A*s6+b1A*p6a1+b2A*p6a2-a1A*q6a1-a2A*q6a2; p6a2=p6a1;p6a1=s6;q6a2=q6a1;q6a1=oA;
    oB=b0B*oA+b1B*p6b1+b2B*p6b2-a1B*q6b1-a2B*q6b2; p6b2=p6b1;p6b1=oA;q6b2=q6b1;q6b1=oB; y6=oB;
);

out0=y1; out1=y2; out2=y3; out3=y4; out4=y5; out5=y6;
